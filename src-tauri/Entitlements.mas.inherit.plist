<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The SIP engine (Contents/MacOS/baresip) is a child process of the application. It runs in the
       application's sandbox, with its permissions (network, microphone): the sandbox accepts nothing else
       in the entitlements of an inheriting executable. -->
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.inherit</key>
  <true/>
</dict>
</plist>
