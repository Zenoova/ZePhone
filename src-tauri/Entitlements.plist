<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Microphone access (hardened runtime / notarisation). The child process
       (Baresip) is attributed to the app bundle by TCC. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Contacts (hardened runtime / notarisation): the "Contacts du Mac" source reads the address book, read-only,
       after the user allowed it. Nothing is ever written to it. -->
  <key>com.apple.security.personal-information.addressbook</key>
  <true/>
  <!-- Network client + server: SIP signalling and RTP media sockets. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>
  <!-- Baresip loads its modules (.so) with dlopen: they are signed ad hoc, not by
       our team id, so library validation must be relaxed under hardened runtime. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
